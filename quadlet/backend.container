[Unit]
Requires=db.service redis-cache.service redis-queue.service
After=db.service redis-cache.service redis-queue.service

[Container]
Environment=DB_HOST=systemd-db DB_PORT=3306 MYSQL_ROOT_PASSWORD=admin MARIADB_ROOT_PASSWORD=admin
Image=docker.io/frappe/erpnext:v15.84.0
Network=systemd-frappe_network
Volume=sites:/home/frappe/frappe-bench/sites
Volume=logs:/home/frappe/frappe-bench/logs

[Service]
Restart=on-failure
